# Grist (inchangé)
GRIST_HOST=https://docs.getgrist.com
GRIST_API_KEY=ta_cle_api_ici
GRIST_DOC_ID=uuid-du-document
GRIST_TABLE_ID=Clients
GRIST_COLUMNS=Nom_historique,URL_Github,Changelog_Normalise,Nom_Harmonise,Internalisation_Gitlab

# Récupération de fichiers depuis Git
FILE_FETCH_INPUT_JSON=export_grist.json
FILE_FETCH_OUTPUT_DIR=fichiers_recuperes

# Nom de la propriété qui donne l'URL du dépôt Git
FILE_FETCH_URL_PROPERTY=URL_Github

# Chemin du fichier à récupérer dans le dépôt
FILE_FETCH_FILE_PATH=CHANGELOG.md

# Branche par défaut si non détectée dans l'URL
FILE_FETCH_DEFAULT_BRANCH=main

# Propriété JSON à utiliser comme « nom de projet » dans le nom de fichier
# Exemples : "Nom_Harmonise", "Nom_historique", "Projet", "Slug", etc.
FILE_FETCH_NAME_PROPERTY=Nom_Harmonise

# Motif de nommage du fichier de sortie.
# Placeholders disponibles :
#   {name}  = valeur de la propriété FILE_FETCH_NAME_PROPERTY (ou fallback)
#   {file}  = FILE_FETCH_FILE_PATH avec '/' remplacé par '_'
#   {ext}   = extension du fichier cible (ex. .md, .txt, .yaml)
#
# Exemples :
#   "{name}-{file}.txt"
#   "{name}.txt"
#   "{name}-{file}"
#   "{name}_changelog.txt"
FILE_FETCH_OUTPUT_PATTERN="{name}-{file}.txt"

# GitLab
GITLAB_HOST=https://gitlab.example.com
GITLAB_TOKEN=ton_token_gitlab_ici

